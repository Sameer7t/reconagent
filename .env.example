# =============================================================================
# ReconAgent Environment Configuration Template
# Copy this file to .env and configure with your environment secrets:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Google Gemini API Credentials
# Required for multi-modal document extraction and LangGraph agent reasoning
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# Used by docker compose for containerized PostgreSQL deployment
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=reconagent
POSTGRES_PORT=5432

# Connection string used by backend application to connect to PostgreSQL
# In Docker Compose, the host is 'db': postgresql://postgres:root@db:5432/reconagent
# For local host development, host is 'localhost': postgresql://postgres:root@localhost:5432/reconagent
DATABASE_URL=postgresql://postgres:root@db:5432/reconagent

# Database Connection Pool Settings
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=20

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
SECRET_KEY=reconagent-production-secret-change-in-prod-xyz123
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# Application Runtime Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# Comma-separated list of allowed origins (or * for universal development access)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173,http://localhost:8000
